# Shared Goals platform API. Do not include /api/v1.
SHARED_GOALS_API_BASE_URL=http://localhost:8016

# Agent key id sent as the X-Agent-Key-Id header.
SHARED_GOALS_AGENT_KEY_ID=example-agent-key

# Local Obsidian vault that contains Compass.md.
# If unset, make compass-update uses ~/Compass.md.
OBSIDIAN_VAULT_PATH="/Users/example/Library/Mobile Documents/iCloud~md~obsidian/Documents/Internal"

# Optional SSH host for reading daily-compass-context.json from the Hermes host.
# Example: COMPASS_LOGOS_REMOTE=hermes@host
COMPASS_LOGOS_REMOTE=